DATABASE_PATH=data/charity_links.sqlite
CACHE_DIR=data/http_cache

CHARITY_COMMISSION_API_KEY=
COMPANIES_HOUSE_API_KEY=
SERPER_API_KEY=

GEMINI_API_KEY=
GEMINI_RESOLUTION_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Natural-language planning and resolution use OpenRouter ZDR routes only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CASE_MODEL=~deepseek/deepseek-v4-flash-latest
OPENROUTER_CASE_REASONING_EFFORT=medium
RESOLUTION_PROVIDER=openrouter
OPENROUTER_RESOLUTION_MODEL=~deepseek/deepseek-v4-flash-latest
RESOLUTION_WORKERS=4

PDF_ENRICHMENT_ENABLED=1
PDF_ENRICHMENT_MAX_DOCUMENTS=3
PDF_ENRICHMENT_MAX_CHUNKS=4
